{
  "name": "@esteira/cli",
  "version": "0.2.3",
  "description": "Esteira — secure adaptive CI/CD & vulnerability-audit pipeline. gh extension: gh esteira init|analyze|gate|audit",
  "type": "module",
  "bin": {
    "gh-esteira": "src/index.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "analyze": "node src/index.mjs analyze --json",
    "typecheck": "node node_modules/typescript/bin/tsc -p .",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
